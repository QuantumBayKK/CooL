{
  "name": "cool-site-v2",
  "version": "3.0.0",
  "private": true,
  "description": "CooL — cryptographic evidence for AI change. Public site, evidence surfaces, investor portal.",
  "scripts": {
    "dev": "next dev -p 3002",
    "build:validator": "tsx scripts/build-validator.mjs",
    "verify:validator": "tsx scripts/build-validator.mjs --check",
    "prebuild": "npm run build:validator",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "verify:palette": "node scripts/verify-palette.mjs",
    "verify:claims": "node scripts/verify-claims.mjs",
    "verify:rls": "node scripts/verify-rls.mjs",
    "verify:sdk": "tsx scripts/verify-sdk.ts",
    "verify:tee": "tsx scripts/verify-tee.ts",
    "verify:all": "npm run typecheck && npm run verify:validator && npm run verify:palette && npm run verify:claims && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "^0.4.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.4",
    "ajv": "^8.20.0",
    "cbor2": "^1.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.8",
    "lucide-react": "^1.26.0",
    "minisearch": "^7.2.0",
    "motion": "^13.0.0",
    "next": "^16.3.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "shiki": "^4.4.2",
    "tailwind-merge": "^3.6.0",
    "ulid": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.49.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.5",
    "typescript": "^5.7.3"
  }
}
