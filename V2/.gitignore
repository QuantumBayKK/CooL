node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
.vercel

# ── secrets ────────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY bypasses every row-level security policy in the
# database, and the session secrets forge investor and admin sessions. Only
# `.env.example` — which contains no values — is tracked.
.env
.env.*
!.env.example

# Supabase CLI working state: container ids, generated keys, temp dumps.
supabase/.branches/
supabase/.temp/

# ── build/test artefacts ───────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
lighthouse/

# Raw source 3D assets — 59 MB, one file 37 MB. Kept out of the clone; the
# 3D layer itself was removed in the enterprise rebuild, so nothing in the app
# reads these any more. Retained here so a stale working copy cannot commit
# them by accident.
3d models/

# Incidental screenshots dropped in the project root.
WhatsApp Image*.jpeg
WhatsApp Image*.jpg

# Generated by Next 16 on every build (disabled via next.config agentRules).
AGENTS.md
CLAUDE.md

# The Studio was delivered as an archive; its contents are vendored into
# public/studio/. The archive itself is not a build input.
cool-recorder-studio.zip
